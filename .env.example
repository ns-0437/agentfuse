# Copy to .env (or export) to enable the "real" backends.
# Everything runs offline (mock recovery + local/lexical drift) without any of
# this — the demos never require a key, and mock recovery is the
# measured-BETTER default (REPORT.md 3.4/8.1): a real reasoning-model backend
# loses to the deterministic ladder at every model size tested. This key
# alone does NOT switch the recovery backend -- see AGENTFUSE_RECOVERY_BACKEND
# below, which is the deliberate, explicit opt-in (REPORT.md 3.34).
OPENAI_API_KEY=sk-...

# Explicit opt-in to the reasoning-model recovery backend (measured worse,
# see above) instead of the deterministic ladder. Requires OPENAI_API_KEY.
# AGENTFUSE_RECOVERY_BACKEND=real

# Reasoning model used by the recovery/steering engine, only if the line
# above is uncommented (default: o4-mini).
AGENTFUSE_RECOVERY_MODEL=o4-mini

# Embedding model used by the drift detector when a hosted embedder is
# actually in use (default: text-embedding-3-small). Local ONNX embeddings
# (pip install agentfuse[embeddings]) are tried FIRST and need no key at all;
# this only matters if that extra is not installed.
AGENTFUSE_EMBED_MODEL=text-embedding-3-small

# Force the lexical drift-detection fallback even if OPENAI_API_KEY is set
# and no local embedder is installed (skips the hosted-embeddings warning).
# AGENTFUSE_EMBED_BACKEND=none
