# Copy to .env (or export) to enable the "real" backends.
# Everything runs offline (mock) without these — the demos never require a key.

# Enables real reasoning-model recovery + embedding-based drift detection.
OPENAI_API_KEY=sk-...

# Reasoning model used by the recovery/steering engine (default: o4-mini).
AGENTFUSE_RECOVERY_MODEL=o4-mini

# Embedding model used by the drift detector (default: text-embedding-3-small).
AGENTFUSE_EMBED_MODEL=text-embedding-3-small
